# ============================================================
# SCPA Environment Configuration Template
# Copy this file to .env and fill in values from your secret manager
# ============================================================
# NEVER commit the actual .env file to version control.
#     Ensure .gitignore includes .env, .env.*, and sensitive files.
# ============================================================

# -- Application --
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json
HEALTH_PORT=8005

# -- Docker / Compose --
COMPOSE_PROJECT_NAME=scpa

# -- Database (PostgreSQL) --
POSTGRES_USER=scpa_user
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
POSTGRES_DB=scpa_db
DATABASE_URL="postgresql+psycopg2://scpa_user:CHANGE_ME@localhost:5432/scpa_db"
# Docker Compose service-to-service URL used by the gateway container.
GATEWAY_DATABASE_URL="postgresql+asyncpg://scpa_user:CHANGE_ME_USE_STRONG_PASSWORD@postgres:5432/scpa_db"

# -- Redis --
REDIS_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
REDIS_URL="redis://default:CHANGE_ME@localhost:6379/0"

# -- Authentication --
SECRET_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64
JWT_REFRESH_EXPIRY_DAYS=30
INTERNAL_SERVICE_TOKEN=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# -- ML Services (Internal) --
NCF_SERVICE_URL=http://ncf-service:8001
SBERT_SERVICE_URL=http://sbert-service:8002
DQN_SERVICE_URL=http://dqn-service:8003
HYBRID_SERVICE_URL=http://hybrid-service:8004
SCRAPER_URL=http://scraper:8001
SBERT_URL=http://sbert:8002
NCF_URL=http://ncf:8003
DQN_URL=http://dqn:8004
PIPELINE_URL=http://pipeline:8005
# SBERT runtime uses the fine-tuned checkpoint produced by
# notebooks/03_sbert_fine_tuning_hybrid_research_manual_v3.ipynb.
SBERT_ENABLE_TRANSFORMER=1
SBERT_MODEL_LOADER=transformers
SBERT_MAX_SEQ_LENGTH=256
# For local non-Docker SBERT runs, override MODEL_DIR only if you move the checkpoint.
# Default code path: models/sbert-indonesian-hybrid-manual-research/best
# Docker path: /app/weights/sbert mounted from that same local checkpoint.
# MODEL_DIR=models/sbert-indonesian-hybrid-manual-research/best
# Leave empty to use the built-in multi-source Indonesian registry.
SCRAPER_SEED_URLS=
SCRAPER_INDONESIA_ONLY=true
# Set to true only when you intentionally want /scrape/run to use bundled sample jobs.
SCRAPER_SAMPLE_ONLY=false
SCRAPER_MAX_URLS_PER_RUN=80
SCRAPER_CONCURRENCY=6

# -- Frontend --
NEXT_PUBLIC_API_URL=http://localhost:9000
PUBLIC_GATEWAY_URL=http://localhost:9000

# -- Job Catalog --
# Hide jobs older than this many days (by posted_at) from the public catalog,
# facets, and counts, including the "all time" range. Set to 0 to disable.
JOB_CATALOG_MAX_AGE_DAYS=90

# -- Pipeline Config (v2) --
# Master switches
SCRAPING_ENABLED=true
SCRAPING_INTERVAL_HOURS=1
JOBS_TARGET=2000
PIPELINE_RUN_ON_STARTUP=true
PIPELINE_USE_DB_CANDIDATES=true
PIPELINE_CANDIDATE_POOL_LIMIT=250
CONTINUAL_TRAINING_INTERVAL_SECONDS=3600

# Continuous realtime scraper worker. `SCRAPER_TEST_MAX_CYCLES` is only for
# bounded local validation; production continuous mode should leave it empty.
SCRAPER_CONTINUOUS_ENABLED=false
SCRAPER_CYCLE_LIMIT=10
SCRAPER_CYCLE_INTERVAL_SECONDS=900
SCRAPER_MAX_EMPTY_CYCLES_BEFORE_BACKOFF=3
SCRAPER_BACKOFF_MIN_SECONDS=60
SCRAPER_BACKOFF_MAX_SECONDS=1800
SCRAPER_ALLOWED_SOURCES=kalibrr
SCRAPER_RUN_FOREVER=true
SCRAPER_TEST_MAX_CYCLES=
SCRAPER_CYCLE_JITTER_SECONDS=5
SCRAPER_QUALITY_MIN_DESC_CHARS=300

# Per-source toggles (default values shown). Stealth/Playwright sources
# require ``scrapling install`` to download Patchright browsers.
PIPELINE_INDONESIA_ONLY=true
PIPELINE_ENABLE_REMOTIVE=false
PIPELINE_ENABLE_LINKEDIN=true
PIPELINE_ENABLE_INDEED=true
PIPELINE_ENABLE_JOBSTREET=true
PIPELINE_ENABLE_GLINTS=true
PIPELINE_ENABLE_KALIBRR=true
PIPELINE_ENABLE_KARIR=true
PIPELINE_ENABLE_TECHINASIA=true

# Observability
PIPELINE_ENABLE_PROMETHEUS=true

# -- Security / CORS --
# In production, set APP_ENV=production and replace localhost origins.
# Wildcard CORS origins are rejected when APP_ENV=production.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8000
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=Content-Type,Authorization,X-Requested-With
ALLOWED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=60

# -- Observability --
SENTRY_DSN=
OTEL_EXPORTER_ENDPOINT=http://localhost:4317

# -- Email (Future) --
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
